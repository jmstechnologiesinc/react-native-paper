{
  "name": "@jmstechnologiesinc/react-native-paper",
  "version": "5.12.10",
  "description": "Material design for React Native",
  "main": "lib/commonjs/index.js",
  "module": "lib/module/index.js",
  "react-native": "src/index.tsx",
  "source": "src/index.tsx",
  "types": "lib/typescript/index.d.ts",
  "files": [
    "src",
    "lib",
    "babel.js"
  ],
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "https://github.com/jmstechnologiesinc/react-native-paper.git"
  },
  "author": "",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/jmstechnologiesinc/react-native-paper/issues"
  },
  "homepage": "https://callstack.github.io/react-native-paper",
  "keywords": [
    "android",
    "ios",
    "react native",
    "component library",
    "ui kit",
    "material design",
    "bootstrap"
  ],
  "scripts": {
    "typescript": "tsc --noEmit",
    "lint": "yarn lint-no-fix --fix",
    "lint-no-fix": "eslint --ext '.js,.ts,.tsx' .",
    "test": "jest",
    "prepack": "bob build && node ./scripts/generate-mappings.js",
    "release": "release-it",
    "bootstrap": "yarn --cwd example && yarn --cwd docs && yarn",
    "docs": "yarn --cwd docs",
    "example": "yarn --cwd example"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "dependencies": {
    "@callstack/react-theme-provider": "^3.0.9",
    "@jmstechnologiesinc/material-tokens": "^0.0.17",
    "@jmstechnologiesinc/react-native-image-blur-loading": "^1.2.4",
    "@jmstechnologiesinc/react-native-size-matters": "^0.4.2",
    "color": "^4.2.3",
    "use-latest-callback": "^0.2.1"
  },
  "devDependencies": {
    "@babel/core": "^7.20.7",
    "@babel/plugin-proposal-export-namespace-from": "^7.18.9",
    "@babel/runtime": "^7.20.7",
    "@callstack/eslint-config": "^13.0.2",
    "@commitlint/config-conventional": "^8.3.4",
    "@react-native/babel-preset": "0.85.0",
    "@react-native/jest-preset": "0.85.0",
    "@react-navigation/native": "^6.1.2",
    "@release-it/conventional-changelog": "^1.1.0",
    "@testing-library/react-native": "^13.0.0",
    "@types/color": "^3.0.0",
    "@types/jest": "^29.2.1",
    "@types/node": "^20.19.4",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/react-test-renderer": "^19.0.0",
    "@typescript-eslint/eslint-plugin": "^5.41.0",
    "@typescript-eslint/parser": "^5.41.0",
    "all-contributors-cli": "^6.24.0",
    "babel-cli": "^6.26.0",
    "babel-core": "^7.0.0-bridge.0",
    "babel-jest": "^26.1.0",
    "babel-loader": "^8.2.3",
    "babel-test": "^0.1.1",
    "chalk": "^4.0.0",
    "commitlint": "^8.3.4",
    "conventional-changelog-cli": "^2.0.11",
    "dedent": "^0.7.0",
    "eslint": "8.31.0",
    "eslint-plugin-flowtype": "^8.0.3",
    "eslint-plugin-local-rules": "^1.3.2",
    "expo-constants": "^9.3.5",
    "glob": "^7.1.3",
    "husky": "^1.3.1",
    "jest": "^29.2.1",
    "jest-file-snapshot": "^0.3.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.85.0",
    "react-native-builder-bob": "^0.40.0",
    "react-native-safe-area-context": "^5.0.0",
    "react-native-vector-icons": "^10.2.0",
    "react-test-renderer": "19.2.3",
    "release-it": "^13.4.0",
    "rimraf": "^3.0.2",
    "typescript": "^5.3.0"
  },
  "peerDependencies": {
    "react": ">=19.0.0",
    "react-native": ">=0.85.0",
    "react-native-safe-area-context": ">=5.0.0",
    "react-native-vector-icons": ">=10.0.0"
  },
  "husky": {
    "hooks": {
      "commit-msg": "commitlint -E HUSKY_GIT_PARAMS",
      "pre-commit": "yarn lint && yarn typescript && yarn test"
    }
  },
  "jest": {
    "preset": "@react-native/jest-preset",
    "setupFiles": [
      "<rootDir>/testSetup.js"
    ],
    "cacheDirectory": "./cache/jest",
    "modulePathIgnorePatterns": [
      "<rootDir>/example/node_modules",
      "<rootDir>/lib/"
    ],
    "watchPathIgnorePatterns": [
      "__fixtures__\\/[^/]+\\/(output|error)\\.js"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!(@react-native|react-native(-.*)?|@jmstechnologiesinc|@d11)/)"
    ]
  },
  "greenkeeper": {
    "ignore": [
      "expo",
      "flow-bin",
      "react",
      "react-dom",
      "react-native",
      "react-test-renderer",
      "@types/react-native",
      "@types/jest",
      "husky",
      "eslint"
    ]
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      "commonjs",
      "module",
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  }
}
